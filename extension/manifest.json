{
  "manifest_version": 3,
  "name": "Gulp Suppressor",
  "version": "0.4.1",
  "description": "Mutes the lecturer's swallowing sounds in Buders YouTube lectures, on this computer only.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Gulp Suppressor",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["worklet.js", "engine.js", "gain.js", "webm.js", "ahead.js", "ahead_core.js", "model.json"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
